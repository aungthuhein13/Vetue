generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model Product {
    id            String         @id @default(cuid())
    slug          String         @unique
    title         String
    brand         String
    description   String         @default("")
    originalPrice Decimal
    salePrice     Decimal
    condition     Condition
    qty           Int            @default(1)
    sourceVendor  String
    images        ProductImage[]
    createdAt     DateTime       @default(now())
    updatedAt     DateTime       @updatedAt
}

model ProductImage {
    id        String  @id @default(cuid())
    url       String
    sortOrder Int     @default(0)
    product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
    productId String
}

enum Condition {
    NEW
    LIKE_NEW
    VERY_GOOD
    GOOD
}
